{
  "//": "Settings for compiling the SERVER (Node.js) code into dist/server.",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist/server",
    "types": ["node"]
  },
  "include": ["server", "shared"]
}
